{
  "name": "abalone-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "wasm": "wasm-pack build ../crates/abalone-wasm --target web",
    "dev": "bun run wasm && vite",
    "test": "vitest run --coverage",
    "e2e": "playwright test --project=chromium",
    "e2e:all": "playwright test",
    "build": "bun run wasm && tsc --noEmit && vite build"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "5.0.5",
    "fake-indexeddb": "6.2.5",
    "gltfpack": "1.3.0",
    "jsdom": "29.1.1",
    "three": "0.186.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "trystero": "0.26.0"
  }
}
