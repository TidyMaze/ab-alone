{
  "name": "abalone-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "wasm": "wasm-pack build ../crates/abalone-wasm --target web",
    "dev": "bun run wasm && vite",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:scoped": "bun run scripts/test-scoped.ts",
    "layout:check": "bun run scripts/check-layout-bounds.ts",
    "e2e:layout": "playwright test e2e/phone-layout.spec.ts --project=chromium",
    "e2e": "playwright test --project=chromium --project=chromium-serial",
    "e2e:contrast": "E2E_CONTRAST=1 playwright test --project=chromium --grep @contrast --retries=0",
    "e2e:all": "playwright test",
    "e2e:webgpu": "playwright test -c playwright.webgpu.config.ts",
    "build": "bun run wasm && tsc --noEmit && vite build"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "5.0.5",
    "fake-indexeddb": "6.2.5",
    "gltfpack": "1.3.0",
    "jpeg-js": "0.4.4",
    "jsdom": "29.1.1",
    "ktx2-encoder": "0.6.0",
    "pngjs": "7.0.0",
    "three": "0.186.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "trystero": "0.26.0"
  }
}
